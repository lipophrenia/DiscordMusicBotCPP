# Discord bot token from the Developer Portal.
DISCORD_TOKEN=replace_me

# Optional development guild ID for immediate command registration.
DISCORD_GUILD_ID=

DEFAULT_VOLUME=50
MAX_TRACK_DURATION=10800
IDLE_TIMEOUT=300

# Download cursor lead over playback, in seconds (5..3600).
BUFFER_AHEAD_SECONDS=60
PREBUFFER_SECONDS=2

# Optional Netscape cookie file. For the package, use an absolute path under
# /etc/discord-music-bot and make it readable by group discord-music-bot.
YOUTUBE_COOKIES_FILE=

YT_DLP_PATH=yt-dlp
DENO_PATH=deno
