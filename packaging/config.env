# Discord bot token from the Developer Portal.
DISCORD_TOKEN=replace_me

# Optional guild ID for immediate slash-command registration while developing.
DISCORD_GUILD_ID=

DEFAULT_VOLUME=50
MAX_TRACK_DURATION=10800
IDLE_TIMEOUT=300

# Downloader and player use separate cursors. This limits the downloader lead.
BUFFER_AHEAD_SECONDS=60
PREBUFFER_SECONDS=2

# Optional Netscape-format cookie file for age-restricted videos.
YOUTUBE_COOKIES_FILE=

# Normally resolved from PATH.
YT_DLP_PATH=/usr/lib/discord-music-bot/yt-dlp
DENO_PATH=/usr/lib/discord-music-bot/deno
