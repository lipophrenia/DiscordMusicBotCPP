[Unit]
Description=Discord YouTube Music Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=discord-music-bot
Group=discord-music-bot
EnvironmentFile=/etc/discord-music-bot/config.env
Environment=DENO_DIR=/var/cache/discord-music-bot/deno
Environment=XDG_CACHE_HOME=/var/cache/discord-music-bot
ExecStart=/usr/bin/discord-music-bot
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

StateDirectory=discord-music-bot
CacheDirectory=discord-music-bot
CacheDirectoryMode=0700
WorkingDirectory=/var/lib/discord-music-bot
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
